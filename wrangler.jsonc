{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "impactlayer-exception-desk",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-29",
  "vars": {
    "NEBIUS_MODEL": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "USAGE",
      "database_name": "exception-desk-demo",
      "database_id": "18f2862d-b729-4000-bf31-a0d05a31e5d9"
    }
  ],
  "ratelimits": [
    {
      "name": "PER_IP",
      "namespace_id": "202609291",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "workers_dev": true
}
